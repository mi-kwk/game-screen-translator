<Window x:Class="GameScreenTranslator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ゲーム画面翻訳" Width="1100" Height="760" MinWidth="760" MinHeight="560" Background="#F4F6FA" PreviewKeyDown="OnKeyDown" AllowDrop="True" Drop="OnDrop">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="ゲーム画面翻訳" FontSize="28" FontWeight="Bold"/><TextBlock Margin="0,6,0,18" Text="Windows + Shift + S で撮影 → ここに Ctrl + V で貼り付け" Foreground="#526075"/></StackPanel>
<WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,16"><Button Content="画像を貼り付け" Click="PasteClick"/><Button Content="画像を開く" Click="OpenClick"/><Button Content="英語を読み取り" Click="OcrClick"/><Button Content="日本語に翻訳" Click="TranslateClick"/><Button Content="訳をコピー" Click="CopyClick"/><CheckBox x:Name="AutoTranslate" Content="読み取り後に自動翻訳" IsChecked="True" VerticalAlignment="Center"/></WrapPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="スクリーンショット" FontWeight="Bold" Margin="0,0,0,12"/><ScrollViewer Grid.Row="1"><Image x:Name="Preview" Stretch="Uniform"/></ScrollViewer></Grid></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="読み取った英語（修正して再翻訳できます）" Margin="0,0,0,8"/><TextBox x:Name="English" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
<DockPanel Grid.Row="2" Margin="0,12,0,6" LastChildFill="True">
<TextBlock Text="日本語訳" VerticalAlignment="Center" Margin="0,0,12,0"/>
<Button x:Name="CancelButton" DockPanel.Dock="Right" Content="中止 (Esc)" Click="CancelClick" Margin="0" Padding="12,4" Visibility="Collapsed" ToolTip="翻訳を止めます。途中までの訳は残ります。"/>
<StackPanel x:Name="Working" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
<ProgressBar x:Name="WorkingBar" IsIndeterminate="True" Width="140" Height="8" Margin="0,0,10,0" Foreground="#3B82F6"/>
<TextBlock x:Name="WorkingText" Foreground="#385777" VerticalAlignment="Center"/>
</StackPanel>
</DockPanel>
<TextBox x:Name="Japanese" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Grid>
<StackPanel Grid.Row="3" Margin="0,16,0,0">
<Expander Header="翻訳の設定(Ollama)">
<Grid Margin="0,10,0,10">
<Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<TextBlock Grid.ColumnSpan="4" TextWrapping="Wrap" Foreground="#526075" Text="翻訳はこの PC の Ollama で行い、インターネットには送信しません。設定はこの Windows ユーザーの LocalAppData に保存します。"/>
<TextBlock Grid.Row="1" Text="モデル" VerticalAlignment="Center" Margin="0,8,8,0"/>
<TextBox x:Name="Model" Grid.Row="1" Grid.Column="1" Margin="0,8,16,0" FontSize="14" Padding="6" ToolTip="例: gemma3:12b(RTX 3060 など)、gemma3:27b(RTX 3090 など)"/>
<TextBlock Grid.Row="1" Grid.Column="2" Text="Ollama のアドレス" VerticalAlignment="Center" Margin="0,8,8,0"/>
<TextBox x:Name="OllamaUrl" Grid.Row="1" Grid.Column="3" Margin="0,8,0,0" FontSize="14" Padding="6"/>
<TextBlock Grid.Row="2" Text="ゲーム名" VerticalAlignment="Center" Margin="0,8,8,0"/>
<TextBox x:Name="GameName" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" FontSize="14" Padding="6" ToolTip="例: Active Matter(脱出型のマルチプレイ FPS)"/>
<TextBlock Grid.Row="3" Text="単語辞書" Margin="0,8,8,0"/>
<TextBox x:Name="Glossary" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,8,0,0" FontSize="14" Padding="6" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" ToolTip="1 行に 1 語。例: raid = レイド"/>
<StackPanel Grid.Row="4" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="0,10,0,0"><Button Content="設定を保存" Click="SaveClick"/><TextBlock VerticalAlignment="Center" Foreground="#526075" Text="単語辞書は 1 行に 1 語、「英語 = 訳語」の形で書きます。"/></StackPanel>
</Grid>
</Expander>
<TextBlock x:Name="Status" Margin="0,10,0,0" TextWrapping="Wrap" Text="画像を貼り付けてください。" Foreground="#385777"/>
</StackPanel>
</Grid></Window>

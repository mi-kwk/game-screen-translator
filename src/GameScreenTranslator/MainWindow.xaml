<Window x:Class="GameScreenTranslator.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ゲーム画面翻訳" Width="1100" Height="760" MinWidth="760" MinHeight="560" Background="#F4F6FA" PreviewKeyDown="OnKeyDown" AllowDrop="True" Drop="OnDrop">
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="ゲーム画面翻訳" FontSize="28" FontWeight="Bold"/><TextBlock Margin="0,6,0,18" Text="Windows + Shift + S で撮影 → ここに Ctrl + V で貼り付け" Foreground="#526075"/></StackPanel>
<WrapPanel x:Name="Actions" Grid.Row="1" Margin="0,0,0,16"><Button Content="画像を貼り付け" Click="PasteClick"/><Button Content="画像を開く" Click="OpenClick"/><Button Content="英語を読み取り" Click="OcrClick"/><Button Content="日本語に翻訳" Click="TranslateClick"/><Button Content="訳をコピー" Click="CopyClick"/><CheckBox x:Name="AutoTranslate" Content="読み取り後に自動翻訳" IsChecked="True" VerticalAlignment="Center"/></WrapPanel>
<Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="White" CornerRadius="10" Padding="12"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="スクリーンショット" FontWeight="Bold" Margin="0,0,0,12"/><ScrollViewer Grid.Row="1"><Image x:Name="Preview" Stretch="Uniform"/></ScrollViewer></Grid></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="読み取った英語（修正して再翻訳できます）" Margin="0,0,0,8"/><TextBox x:Name="English" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/><TextBlock Grid.Row="2" Text="日本語訳" Margin="0,16,0,8"/><TextBox x:Name="Japanese" Grid.Row="3" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Grid></Grid>
<StackPanel Grid.Row="3" Margin="0,16,0,0"><Expander Header="DeepL APIの設定"><StackPanel Margin="0,10,0,10"><TextBlock Text="翻訳時は英文のみをDeepLに送信します。APIキーはこのWindowsユーザー用に暗号化して保存します。"/><DockPanel Margin="0,8,0,0"><Button DockPanel.Dock="Right" Content="設定を保存" Click="SaveClick"/><ComboBox x:Name="Plan" DockPanel.Dock="Right" Width="110" SelectedIndex="0" Margin="8,0"><ComboBoxItem Content="API Free"/><ComboBoxItem Content="API Pro"/></ComboBox><PasswordBox x:Name="ApiKey" Padding="8"/></DockPanel></StackPanel></Expander><TextBlock x:Name="Status" Margin="0,10,0,0" TextWrapping="Wrap" Text="画像を貼り付けてください。" Foreground="#385777"/></StackPanel>
</Grid></Window>